{
  "name": "@anon-rpc/browser-harness",
  "version": "0.3.2",
  "description": "anon-rpc browser harness: loads a hash-pinned anon-client worker under null-origin iframe isolation and exposes an anonymized fetch (SPEC \u00a73.1 conformance target).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethereum/anon-rpc.git",
    "directory": "impl/browser-harness"
  },
  "homepage": "https://github.com/ethereum/anon-rpc",
  "keywords": [
    "anon-rpc",
    "ethereum",
    "privacy",
    "rpc",
    "kps",
    "sandbox",
    "wallet"
  ],
  "main": "./dist/host.js",
  "types": "./dist/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/host/index.d.ts",
      "default": "./dist/host.js"
    },
    "./package.json": "./package.json",
    "./iframe-boot.js": "./dist/iframe-boot.js"
  },
  "files": [
    "dist/host.js",
    "dist/host.js.map",
    "dist/iframe-boot.js",
    "dist/types",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p test --noEmit",
    "test": "node check-spec-version.mjs && node test/run.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@kpstreams/webrtc-client": "^0.2.1",
    "@noble/hashes": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0"
  }
}
