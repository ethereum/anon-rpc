{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    // The demo reads the repo's known-workers.json directly (see src/demo/main.ts).
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [],
    // Typecheck against the harness SOURCE so `npm run typecheck` works on a
    // fresh clone before any build (the package's published types live in
    // dist/, which may not exist yet). The bundler still resolves the real
    // package exports at build time.
    "baseUrl": ".",
    "paths": {
      "@anon-rpc/browser-harness": ["../browser-harness/src/host/index.ts"]
    }
  },
  "include": ["src"]
}
