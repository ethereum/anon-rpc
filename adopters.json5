// Who's adopting anon-rpc. Drives the demo's worker picker, the quick start in
// docs/integrate-wallet.md, and https://ethereum.github.io/anon-rpc/adopters/.
// Adding yourself is a PR against this file alone; merging rebuilds the site.
{
  // Anonymizing networks: a client bundle pinned on-chain by an IWorkerSpecifier
  // (SPEC.md §4). `label` splits on the em dash into name + tagline. `kind` is
  // "network" if it really anonymizes, "reference" if it only demonstrates the
  // mechanism — the page badges the two differently. `id` appears in
  // /demo/?worker=<id>, so renaming one breaks published links. The first entry
  // is the demo's default and the sample the wallet guide shows.
  workers: [
    {
      id: "passthrough",
      label: "Passthrough — plain fetch (no anonymization)",
      specifier: "0x4fd77be300f31c5fe6ab266d35d27750a3478d27",
      kind: "reference",
      note: "The minimal reference worker: it fulfils calls with an ordinary fetch, so requests are not anonymized. It demonstrates the sandbox and hash pinning, not privacy.",
    },
    {
      id: "tor-js",
      label: "tor-js — fetch over Tor",
      specifier: "0x700dA3193D35fA54Cd3fBf29B66f2a2A0385659e",
      kind: "network",
      note: "Runs a full Tor client compiled to WebAssembly inside the sandbox, building circuits in the browser. Expect a bootstrap delay before the first response, and higher per-request latency than a direct fetch, since traffic is relayed through multiple hops.",

      // Optional. ONE config (§7.1) that works — not the config: the field is
      // network-defined and opaque to the harness, so document your own schema
      // and expect wallets to write their own values. `exampleConfigNote`
      // renders as a caveat beside it; `url` links the entry's heading.
      exampleConfig: {
        gateways: ["152.236.3.22:12298:uEiCH0VdbhryzJcMtCfB0vLA4sOvHdQ4hq5w7CopcwU59bQ"],
      },
      exampleConfigNote: "Demonstration gateway only: limited capacity, and it may disappear at any time — run your own for anything real. Browsers cannot open the raw TCP that Tor uses, so gateways act as blind KPS relays into the Tor network.",
    },
    {
      id: "nym",
      label: "Nym — fetch over the Nym mixnet",
      specifier: "0x3aCD9742C68F6d993066Ae25533e09b9e1f60eD0",
      kind: "network",
      url: "https://nym.com/",
      note: "Runs a Nym mixnet client compiled to WebAssembly inside the sandbox. Requests travel as Sphinx packets through the mixnet and leave at a Nym IP Packet Router, so the RPC endpoint sees the router's address, not yours. The bundle is about 18 MB and the mixnet takes a few seconds to bootstrap.",
    },
    {
      id: "nox",
      label: "Nox — fetch over a Sphinx mixnet",
      specifier: "0x35133267A8F7EC35046a83DCA0f4Ca8A6e1b7A9A",
      // Optional; absent means Ethereum mainnet (1). The chain the specifier
      // contract lives on — so the chain a wallet's bootstrap RPC must read it
      // from — not the chain the anonymized fetch can reach.
      chainId: 11155111,
      kind: "network",
      url: "https://demo.nox.hisoka.io/anon-rpc",
      note: "Wraps each request in Sphinx packets routed through entry, mix and exit nodes, dialled over KPS. TLS to an https RPC runs inside the worker, so the exit node relays the request without reading it. Mixing adds per-hop delay, so expect slower responses than a direct fetch.",
    },
  ],

  // Wallets and apps shipping anon-rpc to users (the hosts of SPEC.md §2). None
  // yet, and the page says so rather than pretending otherwise. Copy this:
  walletsAndApps: [
    // {
    //   id: "example-wallet",
    //   label: "Example Wallet",
    //   kind: "wallet", // or "app"
    //   url: "https://example.org",
    //   note: "What it is, and how it uses anon-rpc.",
    //   workers: ["tor-js"], // optional; cross-linked to the entries above
    // },
    {
      id: "privacy-pools",
      label: "Privacy Pools",
      kind: "app",
      url: "https://v2.privacypools.com",
      note: "Private deposits, transfers and withdrawals on Ethereum and L2s. Its web app can route every RPC call through anon-rpc when users turn on Connect with Tor in the RPC settings, so the RPC provider never sees the address the call came from. Off by default, and the user picks the gateway.",
      workers: ["tor-js"],
    },
  ],
}
